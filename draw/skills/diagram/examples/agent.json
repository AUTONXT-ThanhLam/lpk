      "row": 1,
      "col": 2
    },
    {
      "id": "docs",
      "in": "tools",
      "title": "Search help articles",
      "icon": "logo:postgresql",
      "desc": "pgvector, top 5",
      "row": 0,
      "col": 0
    },
    {
      "id": "orders",
      "in": "tools",
      "title": "Look up the order",
      "icon": "logo:stripe",
      "desc": "read only",
      "tone": "external",
      "row": 1,
      "col": 0
    },
    {
      "id": "ticket",
      "in": "tools",
      "title": "Hand over to a person",
      "icon": "logo:jira",
