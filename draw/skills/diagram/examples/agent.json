      "col": 3
    }
  ],
  "nodes": [
    {
      "id": "user",
      "title": "Customer",
      "icon": "user",
      "row": 0,
      "col": 0
    },
    {
      "id": "chat",
      "title": "Chat widget",
      "icon": "message-square",
      "desc": "on the help page",
      "row": 0,
      "col": 1
    },
    {
      "id": "loop",
      "in": "agent",
