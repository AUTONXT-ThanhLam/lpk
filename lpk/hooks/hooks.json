{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *'gh '*|*push*) printf '%s' \"$i\" | node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" push-check ;; esac",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" commit",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Edit|Write|NotebookEdit|Agent|Task|mcp__plugin_lpk_chrome-devtools__(navigate_page|new_page)|mcp__.+__(createJiraIssue|editJiraIssue|addOrEditJiraIssueComment|addCommentToJiraIssue|transitionJiraIssue|createIssueLink|addWorklogToJiraIssue|createConfluenceContent|updateConfluenceContent|createConfluencePage|updateConfluencePage|createConfluenceFooterComment|createConfluenceInlineComment|executeWrite|executeDestructive|addGraphContext)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_lpk_lpk__finding_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" stamp",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" post",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" typecheck",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" trim",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" subject",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "{ git rev-parse --git-dir --git-common-dir 2>/dev/null | while IFS= read -r d; do [ -d \"$d/lpk\" ] && echo y; done; ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null; } | grep -q . || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" waive",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" ask",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" stop",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$LPK_ACCOUNT\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" account",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gitleaks >/dev/null || [ -x \"${XDG_DATA_HOME:-$HOME/.local/share}/lpk/bin/gitleaks\" ] || (nohup node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" setup >/dev/null 2>&1 &)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{ git rev-parse --git-dir --git-common-dir 2>/dev/null | while IFS= read -r d; do [ -d \"$d/lpk\" ] && echo y; done; ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null; } | grep -q . || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" start",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "lpk:.*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" card",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/lib/cmd/hook.mjs\" prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
