{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *push*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" push-check",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" push-check",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook commit",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook write",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook post",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook tick",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook stop",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook tick",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gitleaks >/dev/null || [ -x \"${XDG_DATA_HOME:-$HOME/.local/share}/lpk/bin/gitleaks\" ] || (nohup node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" setup >/dev/null 2>&1 &)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls -A \"${XDG_STATE_HOME:-$HOME/.local/state}/lpk/active\" 2>/dev/null)\" ] || exit 0; exec node \"${CLAUDE_PLUGIN_ROOT}/bin/lpk\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
