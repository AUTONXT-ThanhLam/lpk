#!/usr/bin/env node
// lpk: exact facts and checks for an lpk run. Each command in `lib/cmd/` runs from its own module;
// the fact commands that predate them (facts, rules, check, map, mutate, compare, precedent,
// statusline, setup) are handled here.
import { existsSync, mkdirSync, readFileSync, realpathSync, renameSync, statSync, writeFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { dirname, join, relative, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { compareText } from '../lib/compare.mjs';
import { alreadyFixed, alreadyFixedText, buildBundle } from '../lib/facts.mjs';
import { defaultBranch, git, mergeBase, mergeState, scanners, siblingRefs, siblings, top } from '../lib/git.mjs';
import { MAX_SUBJECT } from '../lib/push.mjs';
import { setup } from '../lib/tools.mjs';
import { freshCandidates } from '../lib/hooks.mjs';
import { parseArgs, targetOf } from '../lib/out.mjs';
import { checkText, mapText, mutateText, precedentText, rulesText } from '../lib/report.mjs';
import { changeOf } from '../lib/rules.mjs';

const [cmd, ...argv] = process.argv.slice(2);
// A command added as its own module (`lib/cmd/<name>.mjs`, exporting `main(argv)` that returns the
// exit code) runs here; the rest are handled below.
const CMD = new URL(`../lib/cmd/${cmd}.mjs`, import.meta.url);
if (cmd && /^[a-z-]+$/.test(cmd) && existsSync(CMD)) process.exit(await (await import(pathToFileURL(CMD))).main(process.argv.slice(3)) ?? 0);
const opt = (k) => { const i = argv.indexOf(k); return i < 0 ? undefined : argv[i + 1]; };
const all = (k) => argv.flatMap((a, i) => (a === k ? [argv[i + 1]] : []));
const USAGE = `usage (each command prints its own usage when called wrongly):
 facts and rules
  lpk facts [--repo <dir>] [--base <ref>] [--cached] [--sibling <dir>]... [--out <dir>] [--json]
  lpk facts --about <path>... [--base <target>]   (is a bug already fixed, before any change exists)
  lpk rules [--repo <dir>] [--base <ref>] [--all | --list | --id <id>[,<id>]...]
  lpk rules --test  |  lpk rules --yield [--repo <dir>]  |  lpk rules --prune [--repo <dir>]
  lpk check [--repo <dir>] [--base <ref>] [--sibling <dir>]... [--fresh <state file>]
  lpk map <name>... [--routes] [--guard <name>]... [--repo <dir>] [--sibling <dir>]...
  lpk precedent [<path>...] [--repo <dir>] [--base <ref>]
  lpk cochange [<file>...]  |  lpk floor  |  lpk fixlines [<fix commit>]
 a run
  lpk run start --verify "<command>"... [--verify-final "<command>"]... [--lane quick|full --why "<why>"] [--req "<text>"]... [--scenario "<cmd>" [--expect "<text>"] [--proves R1,R2]]... [--judged "<scenario>" [--proves R1]]... [--target <ref>] [--draft-push]
  lpk run end [--abandon "<why>"]  |  lpk run status  |  lpk run lane full  |  lpk run start --take
  lpk verify [--final]  |  lpk go  |  lpk decide "<what>" --why "<why>"  |  lpk handoff <slice>
 review and proof
  lpk review start <from>..<to>  |  lpk reviews owed  |  lpk reviews fetch --reviewer <login>
  lpk code-review [--range <from>..<to> | --base <ref>] [--model sonnet] [--timeout <s>]
  lpk finding list|get|verdict|fixed|counts
  lpk repro <finding id> | --cmd "<command>" --at commit|base  |  lpk repeat -- <command>
  lpk mutate --test "<command>" --patch <mutant.diff>...  |  lpk compare --run "<command>" --inputs <dir>
  lpk prove --all | <scenario id>...  |  lpk spawn --port <port> -- <command>  |  lpk reap
 measuring what the run cost
  lpk bench [--json] [--lane quick|full] [--runs <n>] [--repo <dir>] [--no-transcripts]
 delivery
  lpk gates  |  lpk report  |  lpk records [--kind <kind>] [--all]  |  lpk ci <pr>  |  lpk waive <id>... --why "<the owner's words>"
 the machine
  lpk meter  |  lpk escapes  |  lpk watch  |  lpk slot -- <command>  |  lpk doctor  |  lpk setup
  lpk version  |  lpk statusline  |  lpk push-check  |  lpk hook <name>   (hooks: JSON on stdin)`;

function resolveBase(repo) {
  const ref = targetOf(repo, opt('--base'));
  if (!ref) { console.error('lpk: no --base given and no default branch found'); process.exit(2); }
  if (argv.includes('--cached')) return git(['rev-parse', ref], repo).trim();
  const mb = mergeBase(repo, ref);
  if (!mb) { console.error(`lpk: no merge base between ${ref} and HEAD`); process.exit(2); }
  return mb;
}

// `lpk mutate` takes only the options its code path reads (its own, `--cached` read by resolveBase and
// `--sibling` read by the shared setup): a stray word or a quoted run of options would otherwise drop a
// mutant without a word. A patch path must exist and not be a directory; a pipe such as `<(git diff)`
// is a patch too.
const MUTATE_USAGE = 'usage: lpk mutate --test "<command>" [--patch <mutant.diff>]... [--file <path>]... [--timeout <s>] [--hunks] [--repo <dir>] [--base <ref>] [--cached]';
function mutateArgs() {
  const a = parseArgs(argv, ['--test', '--patch', '--file', '--timeout', '--repo', '--base', '--sibling'], ['--hunks', '--cached']);
  if (a.error) return { error: a.error };
  const stray = a.words[0] ?? (argv.includes('--') ? '--' : undefined);
  if (stray !== undefined) return { error: `unknown argument ${stray}` };
  if (!a.opt('--test')) return { error: '--test "<command>" is required' };
  const bad = a.all('--patch').map((p) => { try { return statSync(p).isDirectory() ? `--patch ${p} is a directory` : ''; } catch { return `--patch ${p} does not exist`; } }).find(Boolean);
  return bad ? { error: bad } : a;
}

// One line per CI job: its commands, a multi-line script's lines joined in brackets.
function ciLines(ci) {
  const jobs = new Map();
  for (const c of ci) {
    const k = `${c.workflow} ${c.job}`;
    const lines = c.run.split('\n').map((l) => l.trim()).filter((l) => l && !l.startsWith('#'));
    jobs.set(k, [...(jobs.get(k) || []), (lines.length > 1 ? `[${lines.join(' ; ')}]` : lines[0] || '').slice(0, 240)]);
  }
  return [...jobs].map(([k, v]) => `  ${k}: ${v.join(' ; ')}`);
}

// The branch name and commit subjects as they are: which tickets they name is the agent's reading.
function branchLine(repo, commits) {
  const subjects = commits.map((c) => c.subject);
  const more = subjects.length > 20 ? ` | ... ${subjects.length - 20} more` : '';
  return `branch: ${git(['rev-parse', '--abbrev-ref', 'HEAD'], repo).trim()}; commit subjects: ${subjects.slice(0, 20).join(' | ') || 'none'}${more}`;
}

// Whether the branch would merge into the latest default branch as it stands.
function mergeLine(repo) {
  const m = mergeState(repo);
  if (!m) return 'merge: no default branch to compare with';
  if (m.error) return `merge: could not test against ${m.target} (${m.error.split('\n')[0]})`;
  const state = m.conflicts.length ? `CONFLICTS in ${m.conflicts.join(', ')}` : 'merges cleanly';
  const age = m.fetched ? `last fetched ${Math.round((Date.now() - m.fetched) / 60000)} min ago` : 'never fetched';
  return `merge: ${m.behind} commit(s) behind ${m.target} (${age}), ${state}${m.behind ? `; rebase onto ${m.target} and rerun \`lpk verify\` before the PR` : ''}`;
}

// The words after each `--about`, up to the next option, as paths from the repo root. A path is read
// from the current directory, as git reads one.
function aboutPaths(repo) {
  const paths = [];
  argv.forEach((a, i) => { if (a === '--about') for (let j = i + 1; j < argv.length && !argv[j].startsWith('--'); j++) paths.push(argv[j]); });
  return paths.map((p) => { const abs = resolve(p); try { return relative(repo, realpathSync(abs)); } catch { return relative(repo, abs); } });
}

if (cmd === 'facts') {
  const repo = top(resolve(opt('--repo') || '.'));
  if (!repo) { console.error('lpk: not inside a git repository'); process.exit(2); }
  const target = targetOf(repo, opt('--base'));
  // A bug checked before any change exists: only whether it is already fixed elsewhere.
  if (argv.includes('--about')) {
    const paths = aboutPaths(repo);
    const outside = paths.filter((p) => !p || p.startsWith('..'));
    if (!paths.length || outside.length) { console.error(paths.length ? `lpk: not inside ${repo}: ${outside.join(', ') || '(the repo itself)'}` : 'usage: lpk facts --about <path>... [--base <target>] [--repo <dir>]'); process.exit(2); }
    console.log(alreadyFixedText(alreadyFixed(repo, paths, target)));
    process.exit(0);
  }
  const base = resolveBase(repo);
  const cached = argv.includes('--cached');
  const head = cached ? 'staged' : git(['rev-parse', '--short=12', 'HEAD'], repo).trim();
  const out = resolve(opt('--out') || join(process.env.XDG_CACHE_HOME || join(homedir(), '.cache'), 'lpk', repo.split('/').pop(), head));
  const sibs = siblings(repo, all('--sibling'));
  const s = buildBundle({ repo, base, out, cached, sibs, refs: siblingRefs(sibs, all('--sibling')), target });
  writeFileSync(join(out, 'precedent.md'), `${precedentText({ repo, paths: s.files.filter((f) => !f.skipped).map((f) => f.path) })}\n`);
  if (argv.includes('--json')) { console.log(JSON.stringify(s)); process.exit(0); }
  const live = s.files.filter((f) => !f.skipped);
  const flagged = s.commits.filter((c) => c.length > MAX_SUBJECT || c.merge);
  console.log([
    `bundle: ${out}  (bundle.json, full.diff, impact.md, precedent.md, already-fixed.md, base/, g*.diff)`,
    `base: ${base.slice(0, 12)}  head: ${head}`,
    ...(!cached && git(['status', '--porcelain', '--untracked-files=no'], repo).trim() ? ['uncommitted changes are not in this bundle: commit them, or stage them and use --cached'] : []),
    `files: ${live.length} reviewed (+${live.reduce((n, f) => n + f.added, 0)}/-${live.reduce((n, f) => n + f.removed, 0)}), ${s.files.length - live.length} skipped (lockfiles, build output, binary)`,
    `groups: ${s.groups.length}`,
    `siblings searched: ${s.siblings.length ? s.siblings.join(', ') : 'none'}`,
    branchLine(repo, s.commits),
    `commits: ${s.commits.length}${flagged.length ? `; push would be refused: ${flagged.map((c) => `${c.sha} ${c.merge ? 'merge commit' : `${c.length}-char subject`}`).join(', ')}` : ''}`,
    'CI runs:',
    ...(s.ci.length ? ciLines(s.ci) : ['  (no GitHub Actions or GitLab CI steps found; read the repo\'s own CI config, Makefile and package scripts)']),
    mergeLine(repo),
    ...alreadyFixedText(s.alreadyFixed).split('\n').slice(2),
    `dead-code finders on this machine: ${scanners(repo).join(', ') || 'none found'}`,
  ].join('\n'));
} else if (cmd === 'rules' && argv.includes('--test')) {
  const r = (await import('../lib/ast.mjs')).astTest();
  console.log(r.text);
  process.exit(r.ok ? 0 : 1);
} else if (cmd === 'rules' && (argv.includes('--yield') || argv.includes('--prune'))) {
  const repo = top(resolve(opt('--repo') || '.'));
  if (!repo) { console.error('lpk: not inside a git repository'); process.exit(2); }
  const y = await import('../lib/yield.mjs');
  console.log(argv.includes('--prune') ? y.pruneText(repo) : y.yieldText(repo));
} else if (cmd === 'rules' || cmd === 'check' || cmd === 'map' || cmd === 'mutate') {
  const repo = top(resolve(opt('--repo') || '.'));
  const catalogOnly = cmd === 'rules' && (argv.includes('--all') || argv.includes('--list') || argv.includes('--id'));
  if (!repo && !catalogOnly) { console.error('lpk: not inside a git repository'); process.exit(2); }
  const sibs = repo ? siblings(repo, all('--sibling')) : [];
  if (cmd === 'rules' && argv.includes('--id')) {
    const ids = all('--id').flatMap((v) => (v || '').split(',')).map((x) => x.trim()).filter(Boolean);
    if (!ids.length || argv.includes('--all') || argv.includes('--list')) { console.error(USAGE); process.exit(2); }
    const r = rulesText({ repo, mode: 'id', ids });
    if (r.missing.length) { console.error(`lpk: no rule ${r.missing.join(', ')}; \`lpk rules --list\` names them all`); process.exit(2); }
    console.log(r.text);
  } else if (cmd === 'rules') {
    const mode = argv.includes('--all') ? 'all' : argv.includes('--list') ? 'list' : 'diff';
    console.log(rulesText({ repo, base: mode === 'diff' ? resolveBase(repo) : '', mode }));
  } else if (cmd === 'check' && argv.includes('--fresh')) {
    // Only what this state file's agent has not been shown; the file keeps what was shown.
    const state = opt('--fresh');
    if (!state || state.startsWith('--')) { console.error(USAGE); process.exit(2); }
    let seen = [];
    try { if (existsSync(state)) seen = JSON.parse(readFileSync(state, 'utf8')); } catch { seen = null; }
    if (!Array.isArray(seen)) { console.error(`lpk: ${state} is not an lpk check state file (a JSON list); remove it to start over`); process.exit(2); }
    const r = freshCandidates(repo, resolveBase(repo), seen, sibs);
    mkdirSync(dirname(resolve(state)), { recursive: true });
    writeFileSync(`${state}.${process.pid}`, JSON.stringify(r.seen));
    renameSync(`${state}.${process.pid}`, state);
    console.log(r.text || 'lpk check: no new candidates since the last report.');
  } else if (cmd === 'check') console.log(checkText({ repo, base: resolveBase(repo), sibs }));
  else if (cmd === 'map') {
    const flags = new Set(['--repo', '--sibling', '--guard']);
    const names = argv.filter((a, i) => !a.startsWith('--') && !flags.has(argv[i - 1]));
    if (!names.length && !argv.includes('--routes')) { console.error(USAGE); process.exit(2); }
    console.log(mapText({ roots: [repo, ...sibs], refs: siblingRefs(sibs, all('--sibling')), names, routeMode: argv.includes('--routes'), guards: all('--guard') }));
  } else {
    const m = mutateArgs();
    if (m.error) { console.error(`lpk: ${m.error}\n${MUTATE_USAGE}`); process.exit(2); }
    const sub = relative(repo, realpathSync(process.cwd()));
    const r = await mutateText({ repo, base: resolveBase(repo), cmd: m.opt('--test'), sub: sub.startsWith('..') ? '' : sub, only: m.all('--file'), timeout: Number(m.opt('--timeout') || 600), hunks: m.flags.has('--hunks'), patches: m.all('--patch').map((p) => resolve(p)) });
    console.log(r.text);
    process.exit(r.code);
  }
} else if (cmd === 'compare') {
  const repo = top(resolve(opt('--repo') || '.'));
  if (!repo || !opt('--run') || !opt('--inputs')) { console.error(USAGE); process.exit(2); }
  const sub = relative(repo, realpathSync(process.cwd()));
  const r = await compareText({ repo, base: resolveBase(repo), cmd: opt('--run'), inputs: resolve(opt('--inputs')), sub: sub.startsWith('..') ? '' : sub, timeout: Number(opt('--timeout') || 30), jobs: Number(opt('--jobs') || 4) });
  console.log(r.text);
  process.exit(r.code);
} else if (cmd === 'precedent') {
  const repo = top(resolve(opt('--repo') || '.'));
  if (!repo) { console.error('lpk: not inside a git repository'); process.exit(2); }
  const given = argv.filter((a, i) => !a.startsWith('--') && !(i > 0 && argv[i - 1].startsWith('--')));
  const paths = given.length ? given : changeOf(repo, resolveBase(repo)).map((f) => f.path);
  console.log(precedentText({ repo, paths }));
} else if (cmd === 'setup') {
  console.log(setup().join('\n'));
} else {
  console.error(USAGE);
  process.exit(cmd ? 2 : 0);
}
